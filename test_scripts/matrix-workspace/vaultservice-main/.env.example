# App and server config
SPRING_APPLICATION_NAME=vaultservice
SERVER_PORT=6020
VAULTSERVICE_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:6080,http://localhost:8080,http://react-service
LOGGING_LEVEL=INFO

# DB Config
SPRING_DATASOURCE_URL=jdbc:postgresql://vault-db:5432/vaultservice
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vaultservice

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_DATABASE=postgresql
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# JWT keys
JWT_PUBLIC_KEY=change-me # Integration line: Auth
JWT_ISSUER=msinit-authservice # Integration line: Auth

# Secret keys
# Generate these secret keys with the following linux shell command: head /dev/urandom | tr -dc A-F0-9 | head -c32
BOOTSTRAP_TOKEN=change-me
ENCRYPTION_KEY=change-me
AUTH_CICD_TOKEN=change-me # Integration line: Auth
EMAIL_CICD_TOKEN=change-me # Integration line: Email
FILE_CICD_TOKEN=change-me # Integration line: File
GATEWAY_CICD_TOKEN=change-me # Integration line: Gateway
LOGGER_CICD_TOKEN=change-me # Integration line: Logger
REACT_CICD_TOKEN=change-me # Integration line: React
TELEMETRY_CICD_TOKEN=change-me # Integration line: Telemetry
SERVICE_SECRET_VAULT=change-me # Integration line: Auth
SERVICE_HTTP_CONNECT_TIMEOUT=5000
SERVICE_HTTP_READ_TIMEOUT=10000
