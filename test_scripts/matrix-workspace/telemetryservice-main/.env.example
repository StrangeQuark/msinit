# Application settings
SPRING_APPLICATION_NAME=telemetryservice
SERVER_PORT=6050
CORS_ALLOWED_ORIGINS=http://localhost:6080,http://localhost:8080,http://react-service
LOGGING_LEVEL=INFO
ENCRYPT_DATA_AT_REST=true
AUTHSERVICE_INTEGRATION=true
EMAILSERVICE_INTEGRATION=true
FILESERVICE_INTEGRATION=true
VAULTSERVICE_INTEGRATION=true

# MongoDB settings
SPRING_DATA_MONGODB_HOST=telemetry-db
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=telemetryservice
MONGO_ROOT_USERNAME=mongo-root
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_USERNAME=telemetry-app
MONGO_APP_PASSWORD=change-me
MONGO_EXPRESS_USERNAME=mongo-express
MONGO_EXPRESS_PASSWORD=change-me

# Telemetry retention. Set to 0 to keep events forever.
TELEMETRY_RETENTION_DAYS=0

# Kafka settings
SPRING_KAFKA_BOOTSTRAP_SERVERS=telemetry-kafka:9093
SPRING_KAFKA_CONSUMER_GROUP_ID=telemetry-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=org.springframework.kafka.support.serializer.ErrorHandlingDeserializer
SPRING_KAFKA_CONSUMER_PROPERTIES_SPRING_DESERIALIZER_VALUE_DELEGATE_CLASS=org.springframework.kafka.support.serializer.JsonDeserializer
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=telemetry-zookeeper:2182
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://telemetry-kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
SPRING_KAFKA_CONSUMER_PROPERTIES_SPRING_JSON_TRUSTED_PACKAGES=*
SPRING_KAFKA_CONSUMER_PROPERTIES_SPRING_JSON_VALUE_DEFAULT_TYPE=com.example.telemetryservice.event.TelemetryEvent

# Zookeeper settings
ZOOKEEPER_CLIENT_PORT=2182
ZOOKEEPER_TICK_TIME=2000

# JWT keys
JWT_PUBLIC_KEY=change-me
JWT_ISSUER=msinit-authservice

# Secret keys
# Generate these secret keys with the following linux shell command: head /dev/urandom | tr -dc A-F0-9 | head -c32
ENCRYPTION_KEY=change-me
