# App and server config
SPRING_APPLICATION_NAME=gatewayservice
SERVER_PORT=8080
JENKINS_SERVICE_URL=http://jenkins-service:8080
JENKINSSERVICE_INTEGRATION=true
AUTH_SERVICE_URL=http://auth-service:6001
AUTHSERVICE_INTEGRATION=true
EMAIL_SERVICE_URL=http://email-service:6005
EMAILSERVICE_INTEGRATION=true
FILE_SERVICE_URL=http://file-service:6010
FILESERVICE_INTEGRATION=true
VAULT_SERVICE_URL=http://vault-service:6020
VAULTSERVICE_INTEGRATION=true
TELEMETRY_SERVICE_URL=http://telemetry-service:6050
TELEMETRYSERVICE_INTEGRATION=true
REACT_SERVICE_URL=http://react-service
REACTSERVICE_INTEGRATION=true
CORS_ALLOWED_ORIGINS=http://localhost:6080,http://localhost:8080,http://react-service
HOSTS=main=localhost,jenkins=jenkins.localhost*

# Redis rate-limit config
REDIS_HOST=gateway-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_CONNECT_TIMEOUT=10s
REDIS_TIMEOUT=10s

# Allow an average of 5 auth requests per second per client IP, with bursts of 60 requests
AUTH_GATEWAY_RATE_LIMIT_REPLENISH_RATE=5
AUTH_GATEWAY_RATE_LIMIT_BURST_CAPACITY=60

# HTTPS certificate settings
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=file:/gatewayservice/certs/keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=change-me
SERVER_SSL_KEY_STORE_TYPE=PKCS12
