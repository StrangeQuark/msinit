# App and server config
SPRING_APPLICATION_NAME=emailservice
SERVER_PORT=6005
CORS_ALLOWED_ORIGINS=http://localhost:6080,http://localhost:8080,http://react-service
LOGGING_LEVEL=INFO
EMAIL_PUBLIC_BASE_URL=http://localhost:6080
CONFIRMATION_TOKEN_CLEANUP_INTERVAL=3600000
AUTHSERVICE_INTEGRATION=true
TELEMETRYSERVICE_INTEGRATION=true

# PostgreSQL settings
SPRING_DATASOURCE_URL=jdbc:postgresql://email-db:5432/emailservice
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emailservice

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# Mail settings
SPRING_MAIL_HOST=maildev
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=noreply
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=*
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=3000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

# Kafka settings
SPRING_KAFKA_BOOTSTRAP_SERVERS=email-kafka:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=email-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=org.springframework.kafka.support.serializer.ErrorHandlingDeserializer
SPRING_KAFKA_CONSUMER_PROPERTIES_SPRING_DESERIALIZER_VALUE_DELEGATE_CLASS=org.springframework.kafka.support.serializer.JsonDeserializer
SPRING_KAFKA_CONSUMER_PROPERTIES_SPRING_JSON_TRUSTED_PACKAGES=*
SPRING_KAFKA_CONSUMER_PROPERTIES_SPRING_JSON_VALUE_DEFAULT_TYPE=com.example.emailservice.email.EmailRequest
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=email-zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://email-kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Zookeeper settings
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# JWT keys
JWT_PUBLIC_KEY=change-me
JWT_ISSUER=msinit-authservice

# Secret keys
# Generate these secret keys with the following linux shell command: head /dev/urandom | tr -dc A-F0-9 | head -c32
ENCRYPTION_KEY=change-me
SERVICE_SECRET_EMAIL=change-me
SERVICE_HTTP_CONNECT_TIMEOUT=5000
SERVICE_HTTP_READ_TIMEOUT=10000
